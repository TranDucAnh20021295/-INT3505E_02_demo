{
  "name": "library-management-api-v8",
  "version": "8.0.0",
  "description": "RESTful API with JWT Authentication, Search, Pagination, and Advanced Features",
  "main": "index.js",
  "scripts": {
    "prestart": "npm install",
    "start": "node index.js",
    "test": "mocha test/**/*.test.js --timeout 10000",
    "test:watch": "mocha test/**/*.test.js --watch --timeout 10000",
    "test:auth": "mocha test/AuthenticationService.test.js --timeout 10000",
    "test:books": "mocha test/BooksService.test.js --timeout 10000",
    "test:users": "mocha test/UsersService.test.js --timeout 10000",
    "test:loans": "mocha test/LoansService.test.js --timeout 10000",
    "test:search": "mocha test/SearchService.test.js --timeout 10000",
    "test:stats": "mocha test/StatisticsService.test.js --timeout 10000"
  },
  "keywords": [
    "openapi-generator",
    "openapi"
  ],
  "license": "Unlicense",
  "private": true,
  "dependencies": {
    "body-parser": "^1.19.0",
    "camelcase": "^5.3.1",
    "cookie-parser": "^1.4.4",
    "cors": "^2.8.5",
    "express": "^4.16.4",
    "express-openapi-validator": "^4.13.8",
    "js-yaml": "^3.3.0",
    "mongoose": "^8.19.2",
    "ono": "^5.0.1",
    "openapi-sampler": "^1.0.0-beta.15",
    "swagger-ui-express": "^4.0.2",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "chai": "^4.2.0",
    "chai-as-promised": "^7.1.1",
    "eslint": "^5.16.0",
    "eslint-config-airbnb-base": "^14.0.0",
    "eslint-plugin-import": "^2.17.2",
    "mocha": "^7.1.1"
  },
  "eslintConfig": {
    "env": {
      "node": true
    }
  }
}

